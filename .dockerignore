# Version control
.git
.gitignore

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python

# Environment files (secrets — use docker run --env-file instead)
.env
*.env

# Databases — mount as volume instead
*.db

# Local dev artifacts
.pytest_cache
*.egg-info
dist/
build/

# OS artifacts
.DS_Store
Thumbs.db

# Large model caches (sentence-transformers downloads at runtime)
.cache/
models/

# Test files (optional — remove if you want tests in container)
tests/
